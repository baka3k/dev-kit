{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migration-kit.local/schemas/maintenance-manifest-2.0.json",
  "title": "Lifecycle-capable maintenance documentation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "lifecycle_phase", "phase_status", "visibility", "source_revision", "generated_at", "validator_version", "freshness", "review_required", "review_state", "comment_resolution_state", "project_identity", "requested_modes", "stages", "revisions", "artifacts", "evidence", "warnings", "gaps", "resume_state"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "waiting_for_input", "succeeded", "partial", "blocked", "failed"]},
    "lifecycle_phase": {"enum": ["generate", "clarify_refine", "review_update", "complete"]},
    "phase_status": {"enum": ["pending", "running", "waiting_for_input", "succeeded", "partial", "skipped", "blocked", "failed"]},
    "visibility": {"enum": ["internal", "restricted", "public"]},
    "source_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "validator_version": {"type": "string", "minLength": 1},
    "freshness": {"enum": ["current", "possibly_stale", "stale", "unverifiable"]},
    "review_required": {"type": "boolean"},
    "review_state": {"enum": ["unreviewed", "reviewed", "approved"]},
    "comment_resolution_state": {"enum": ["not_started", "comments_pending", "changes_requested", "resolved", "skipped_no_comments", "blocked"]},
    "project_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "project": {"type": "string"},
        "database": {"type": "string"},
        "collection": {"type": "string"}
      }
    },
    "requested_modes": {"type": "array", "items": {"enum": ["system", "usecase", "behavior", "api", "data", "command"]}, "uniqueItems": true},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "revisions": {"type": "array", "items": {"$ref": "#/$defs/revision"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "resume_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint_revision_id": {"type": ["string", "null"]},
        "clarification_cycle": {"type": "integer", "minimum": 0, "maximum": 2},
        "review_round": {"type": "integer", "minimum": 0},
        "pending_input_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.).+"}
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "producer", "status", "output_root", "dependencies", "phase", "attempt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "pattern": "^hi-[a-z0-9-]+$"},
        "status": {"enum": ["pending", "running", "waiting_for_input", "succeeded", "partial", "skipped", "blocked", "failed", "omitted"]},
        "output_root": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "phase": {"enum": ["generate", "clarify_refine", "review_update"]},
        "attempt": {"type": "integer", "minimum": 0}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "parent_revision_id", "phase", "base_sha256", "result_sha256", "path", "created_at", "producer", "changed_artifact_ids"],
      "properties": {
        "revision_id": {"type": "string", "pattern": "^r[0-9]{3}(?:-[a-z0-9-]+)?$"},
        "parent_revision_id": {"type": ["string", "null"]},
        "phase": {"enum": ["generate", "clarify_refine", "review_update"]},
        "base_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"},
        "created_at": {"type": "string", "format": "date-time"},
        "producer": {"type": "string", "pattern": "^hi-[a-z0-9-]+$"},
        "changed_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "producer", "status", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "producer": {"type": "string", "pattern": "^hi-[a-z0-9-]+$"},
        "status": {"enum": ["verified", "partial", "omitted", "stale"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_path", "retrieval_layer", "claim_type", "status", "confidence", "source_revision", "verified_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"},
        "anchor": {"type": "string"},
        "retrieval_layer": {"enum": ["mind", "graph-semantic", "graph-verified", "serena", "rg", "human_declared", "reviewer_declared", "unverified_external"]},
        "claim_type": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "corroborated", "inferred", "unknown", "contradicted", "declared", "unverified"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"retrieval_layer": {"enum": ["human_declared", "reviewer_declared", "unverified_external"]}}, "required": ["retrieval_layer"]},
          "then": {"properties": {"status": {"enum": ["declared", "unverified", "contradicted"]}}}
        }
      ]
    }
  }
}
