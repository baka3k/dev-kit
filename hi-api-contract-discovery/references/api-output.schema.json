{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migration-kit.local/schemas/api-output-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "visibility", "source_revision", "generated_at", "status", "operations", "gaps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope": {"type": "string", "minLength": 1},
    "visibility": {"enum": ["internal", "restricted", "public"]},
    "source_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["succeeded", "partial", "blocked", "failed"]},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "gaps": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "protocol", "address", "handler", "evidence_status", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "protocol": {"enum": ["http", "event"]},
        "method": {"type": "string"},
        "address": {"type": "string", "minLength": 1},
        "handler": {"type": "string", "minLength": 1},
        "evidence_status": {"enum": ["verified", "corroborated", "inferred", "unknown", "contradicted"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"evidence_status": {"enum": ["verified", "corroborated"]}}}, "then": {"properties": {"evidence_refs": {"type": "array", "minItems": 1}}}}]
    }
  }
}
