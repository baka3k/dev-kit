{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migration-kit.local/schemas/document-revision-2.0.json",
  "title": "Immutable document revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_id", "parent_revision_id", "lifecycle_phase", "base_sha256", "result_sha256", "created_at", "producer", "changed_artifact_ids", "artifacts"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "revision_id": {"type": "string", "pattern": "^r[0-9]{3}(?:-[a-z0-9-]+)?$"},
    "parent_revision_id": {"type": ["string", "null"], "pattern": "^r[0-9]{3}(?:-[a-z0-9-]+)?$"},
    "lifecycle_phase": {"enum": ["generate", "clarify_refine", "review_update"]},
    "base_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "pattern": "^hi-[a-z0-9-]+$"},
    "changed_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "status", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["verified", "partial", "omitted", "stale"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
