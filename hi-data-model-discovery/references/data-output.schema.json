{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migration-kit.local/schemas/data-output-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "visibility", "source_revision", "generated_at", "status", "entities", "relationships", "gaps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope": {"type": "string", "minLength": 1},
    "visibility": {"enum": ["internal", "restricted", "public"]},
    "source_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["succeeded", "partial", "blocked", "failed"]},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "gaps": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "fields", "evidence_status", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "layer": {"enum": ["physical", "orm", "domain", "dto", "cache", "inferred"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "evidence_status": {"enum": ["verified", "corroborated", "inferred", "unknown", "contradicted"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "declared", "evidence_status", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "declared": {"type": "boolean"},
        "evidence_status": {"enum": ["verified", "corroborated", "inferred", "unknown", "contradicted"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
